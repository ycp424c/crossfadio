{
  "name": "crossfadio",
  "version": "0.1.0",
  "private": true,
  "description": "Crossfadio - 本地 AI DJ Web App",
  "main": "out/server/index.js",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "dev": "concurrently -k \"pnpm dev:server\" \"pnpm dev:web\"",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.node.json",
    "build": "pnpm build:web && pnpm build:server",
    "check": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "sh scripts/run-tests.sh",
    "test:e2e": "playwright test",
    "start": "node out/server/index.js",
    "preview": "pnpm build && pnpm start"
  },
  "dependencies": {
    "NeteaseCloudMusicApi": "^4.31.0",
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jose": "^6.2.3",
    "lucide-react": "^1.8.0",
    "pino": "^9.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.3",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.18.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
